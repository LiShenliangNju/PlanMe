# QQ 群作业扫描 → 主动询问加入日程 服务配置（模板）
# 请复制为 config.yaml 后填入本机值。
# 重要：NapCat 必须仅监听 127.0.0.1，且 access_token 必须为强随机串，绝不暴露公网。

qq:
  # NapCat 暴露的 OneBot 11 正向 WebSocket 地址（默认端口 3001）
  onebot_ws_url: "ws://127.0.0.1:3001"
  # NapCat 中配置的强 token（务必改掉默认示例，且只绑本地）
  access_token: "your-strong-random-token"
  # 登录 NapCat 的机器人小号 QQ 号（用于读群 + 发私聊）
  bot_user_id: 0000000000
  # 你的主号 QQ 号（接收作业确认私聊、回复指令）
  owner_user_id: 0000000000
  # 仅扫描这些群（群号列表）；留空 [] 表示扫描所有群
  group_whitelist: []
  # 显式指定老师 QQ 号（无论角色）
  teacher_user_ids: []
  # 视为「老师」的群角色：owner=群主, admin=管理员
  teacher_roles:
    - owner
    - admin

detector:
  # 关键词预过滤：命中任一才调用模型，省算力、控频率
  keyword_prefilter:
    - "作业"
    - "截止"
    - "交"
    - "ddl"
    - "周"
    - "实验"
    - "论文"
    - "预习"
    - "复习"
    - "考试"
    - "测验"
    - "任务"
    - "安排"
  # 模型调用最小间隔（秒），防刷屏 / 风控
  throttle_seconds: 2
  # 低于此置信度视为非作业，直接静默丢弃（与 prompt 中告知模型的标准一致）
  min_confidence: 0.6
  # 高于此置信度视为高把握，不经确认直接写入日历（0.6~0.9 之间则询问主人）
  auto_confidence: 0.85

scheduler:
  # 现有日程系统的接收端点（本服务 POST 结构化作业数据，由它创建 iCloud 提醒）
  endpoint: "http://127.0.0.1:8000/api/chat"
  timeout: 125

storage:
  db_path: "qq_homework.db"

notifier:
  # 等待你确认 / 取消的超时时间（秒）；超时自动忽略
  confirm_timeout_seconds: 10000

# 群聊图片抓取 → OCR 转 Markdown 存档（讲座 / 通知类图片）
# 与上面的作业扫描「相互独立」：
#   - qq.group_whitelist 是作业群白名单（且限定老师身份）；
#   - image.group_whitelist 是「图片白名单群」，群内所有图片都视为讲座 / 通知，
#     直接 OCR 存档，不要求发送人是老师。
# 留空 [] 表示「关闭图片抓取」（不会消耗 OCR 算力）。
#
# 处理顺序是「先落库、后 OCR」：图片一到先落盘 + 写库 status=pending，
# 再由后台 worker 排队慢慢 OCR，因此算力慢 / 队列积压 / 进程被杀都不丢图，
# 重启后自动把 pending 的图继续跑完。
image:
  # 仅这些群里的图片会被抓取并 OCR（群号列表）；留空 = 关闭
  group_whitelist: []
  # OCR 使用的本地视觉模型（需先 `ollama pull qwen2.5vl:7b`）
  model: "qwen2.5vl:7b"
  # 同一时刻最多并发 OCR 的图片数（= worker 数，显存紧张时保持 1）
  max_concurrency: 1
  # 两次 OCR 调用的最小间隔（秒）。0 = 不额外空等，串行由 max_concurrency 保证
  throttle_seconds: 0
  # 模型常驻显存时长（不设则 Ollama 默认 5 分钟卸载，下张图要重新加载权重）
  keep_alive: "30m"
  # 上下文长度：默认过大时 KV cache 会挤占显存导致 CPU offload、速度骤降
  num_ctx: 8192
  # 单张图最多输出多少 token
  num_predict: 2048
  # 单次请求超时（秒）
  request_timeout: 300
  # 启动时预热模型（提前装显存，第一张图不等冷启动）
  warmup: true
  # 同一张图最多尝试 OCR 几次，超过则标记 error
  retry_max: 2
  # 图片持久化目录（相对路径以项目根为基准），落盘后才能重启续跑
  image_dir: "data/lecture_images"

# 历史补抓：NapCat 是 push 模式，只推「连接期间」的新消息，
# 进程没跑的时段不会重放。启动时按 group_progress 断点把空窗期补回来。
catchup:
  enabled: true
  page_size: 50
  max_pages: 5
  max_messages_per_group: 200
  max_age_hours: 72
  min_interval_seconds: 300
  # true = 所有已加入的群都补抓（历史量大，谨慎）；false = 仅白名单 + 有断点的群
  include_all_groups: false
